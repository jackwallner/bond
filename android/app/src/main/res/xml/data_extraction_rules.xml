<?xml version="1.0" encoding="utf-8"?>
<!-- The session and the couple live on the server; a restored token from another
     device would sign in as someone else's anonymous user. Back up nothing. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
