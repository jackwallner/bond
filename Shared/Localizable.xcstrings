    "Reminders fire as notifications. No notifications, no reminders. That's the whole app.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التذكيرات تصلك على شكل إشعارات. بلا إشعارات، لا تذكيرات. هذا هو التطبيق كله."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen kommen als Mitteilungen. Ohne Mitteilungen gibt es keine Erinnerungen. Das ist die ganze App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders fire as notifications. No notifications, no reminders. That's the whole app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recordatorios llegan como notificaciones. Sin notificaciones, no hay recordatorios. De eso va toda la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rappels arrivent sous forme de notifications. Sans notifications, pas de rappels. L'app, c'est ça."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os lembretes chegam como notificações. Sem notificações, não há lembretes. Eles são a essência do app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминания приходят как уведомления. Нет уведомлений, нет напоминаний. Вот и всё приложение."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lời nhắc hiện dưới dạng thông báo. Không có thông báo thì không có lời nhắc. Đó là chức năng chính của ứng dụng."
          }
        }
      }
    },
