    "How are we both doing today?": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كيف حالنا اليوم؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie geht's uns beiden heute?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How are we both doing today?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
