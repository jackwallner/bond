    "Little Gestures+ opens up your love-language balance, weekly trends, and personalized insights.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتيح لك Little Gestures+ معرفة توازن لغات الحب، والاتجاهات الأسبوعية، ورؤى مخصصة لك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Little Gestures+ zeigt dir die Balance deiner Liebessprachen, Wochentrends und persönliche Einblicke."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Little Gestures+ opens up your love-language balance, weekly trends, and personalized insights."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con Little Gestures+ puedes ver el equilibrio entre tus lenguajes del amor, las tendencias semanales y análisis personalizados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Little Gestures+ débloque l'équilibre de tes langages d'amour, les tendances de la semaine et des analyses personnalisées."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Little Gestures+ libera o equilíbrio das suas linguagens do amor, tendências semanais e insights personalizados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Little Gestures+ покажет баланс языков любви, тенденции по неделям и персональную аналитику."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Little Gestures+ mở khóa mức cân bằng ngôn ngữ tình yêu, xu hướng theo tuần và phân tích dành riêng cho bạn."
          }
        }
      }
    },
    "Little Gestures+ unlocks answering today's question and seeing each other's response once you've both replied.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتيح لك Little Gestures+ الإجابة عن سؤال اليوم ورؤية إجابة شريكك بعد أن تجيبا معًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Little Gestures+ beantwortest du die heutige Frage und ihr seht gegenseitig eure Antworten, sobald ihr beide geantwortet habt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Little Gestures+ unlocks answering today's question and seeing each other's response once you've both replied."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con Little Gestures+ puedes responder a la pregunta de hoy y ver la respuesta de tu pareja cuando ambos hayan contestado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Little Gestures+ te permet de répondre à la question du jour et de voir la réponse de l'autre quand vous avez tous les deux répondu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Little Gestures+ libera responder à pergunta de hoje e ver a resposta um do outro quando vocês dois responderem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С Little Gestures+ можно ответить на вопрос дня и увидеть ответ друг друга, когда ответите оба."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Little Gestures+ cho phép trả lời câu hỏi hôm nay và xem câu trả lời của nhau khi cả hai đã trả lời."
          }
        }
      }
    },
