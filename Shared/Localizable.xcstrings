    "Acts of Service is your least expressed love language. Consider adding more acts of service reminders.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعمال الخدمة هي لغة الحب الأقل حضورًا لديك. جرّب إضافة المزيد من تذكيرات أعمال الخدمة."
          }
        },
        "de": {
          "stringUnit": {
