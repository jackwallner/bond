    "Create reminders and mark them done to see your relationship analytics.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنشئ تذكيرات وعلّمها كمكتملة لترى إحصاءات علاقتكما."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege Erinnerungen an und hake sie ab, um die Auswertung eurer Beziehung zu sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create reminders and mark them done to see your relationship analytics."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea recordatorios y márcalos como hechos para ver las estadísticas de tu relación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
