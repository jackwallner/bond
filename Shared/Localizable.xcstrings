          }
        }
      }
    },
    "Your payment went through but we're still syncing it. Tap Restore Purchases to finish unlocking.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت عملية الدفع، لكن المزامنة لا تزال جارية. اضغط على استعادة المشتريات لإكمال التفعيل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Zahlung ist durch, wird aber noch synchronisiert. Tippe auf „Käufe wiederherstellen“, um die Freischaltung abzuschließen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your payment went through but we're still syncing it. Tap Restore Purchases to finish unlocking."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu pago se ha realizado, pero aún lo estamos sincronizando. Toca Restaurar compras para completar el desbloqueo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton paiement est passé, mais la synchronisation n'est pas terminée. Touche Restaurer les achats pour finir le déblocage."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu pagamento foi concluído, mas ainda estamos sincronizando. Toque em Restaurar compras para terminar de desbloquear."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Платёж прошёл, но мы ещё его синхронизируем. Нажми «Восстановить покупки», чтобы завершить."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanh toán đã thành công nhưng chúng tôi vẫn đang đồng bộ. Chạm Khôi phục giao dịch để hoàn tất mở khóa."
          }
        }
      }
    },
    "Your payment went through but we're still syncing it. Tap below to finish unlocking.": {
