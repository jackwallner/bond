    "Your love language expression is heavily imbalanced. Try adding reminders in your neglected areas.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التعبير عن لغات الحب لديك غير متوازن بشدة. جرّب إضافة تذكيرات في المجالات التي أهملتها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Liebessprachen sind sehr ungleich verteilt. Versuch es mal mit Erinnerungen in den Bereichen, die zu kurz kommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your love language expression is heavily imbalanced. Try adding reminders in your neglected areas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Expresas tus lenguajes del amor de forma muy desigual. Prueba a añadir recordatorios en las áreas que tienes descuidadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes langages d'amour sont très déséquilibrés. Essaie d'ajouter des rappels dans les domaines que tu délaisses."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas linguagens do amor estão bem desequilibradas. Experimente adicionar lembretes nas áreas que ficaram de lado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твои языки любви проявляются очень неравномерно. Попробуй добавить напоминания там, где их сейчас не хватает."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cách bạn thể hiện ngôn ngữ tình yêu đang lệch khá nhiều. Hãy thử thêm lời nhắc ở những mảng bạn ít để ý."
          }
        }
      }
    },
