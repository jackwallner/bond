    "I want to pair with you on Little Gestures.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أريد أن أربط حسابي بحسابك على Little Gestures."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich möchte mich in Little Gestures mit dir verbinden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I want to pair with you on Little Gestures."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiero vincularme contigo en Little Gestures."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je veux m'associer à toi sur Little Gestures."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quero me conectar com você no Little Gestures."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Давай свяжем наши аккаунты в Little Gestures."
          }
        },
