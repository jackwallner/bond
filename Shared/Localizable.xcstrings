    "%@. Auto-renews unless cancelled.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. يتجدد تلقائيًا ما لم يُلغَ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Verlängert sich automatisch, bis du kündigst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Auto-renews unless cancelled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Se renueva automáticamente salvo que lo canceles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Renouvellement automatique sauf annulation."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Renova automaticamente até ser cancelado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Продлевается автоматически, пока ты не отменишь подписку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Tự động gia hạn trừ khi bạn hủy."
          }
        }
      }
    },
    "%@. Payment charged to your Apple ID. Auto-renews unless cancelled.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. يُخصم المبلغ من حساب Apple ID الخاص بك. يتجدد الاشتراك تلقائيًا ما لم يُلغَ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Die Zahlung wird deiner Apple-ID belastet. Verlängert sich automatisch, bis du kündigst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Payment charged to your Apple ID. Auto-renews unless cancelled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. El pago se carga a tu Apple ID. Se renueva automáticamente salvo que lo canceles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Le paiement est débité de ton compte Apple. Renouvellement automatique sauf annulation."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Cobrança no seu ID Apple. Renova automaticamente até ser cancelado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Оплата списывается с твоей учётной записи Apple ID. Продлевается автоматически, пока ты не отменишь подписку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Khoản thanh toán sẽ được tính vào Apple ID của bạn. Tự động gia hạn trừ khi bạn hủy."
          }
        }
      }
    },
