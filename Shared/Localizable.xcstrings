    "%lld reminders added, spread across the coming days so they arrive one at a time, not all at once. Customize any of them anytime.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "تمت إضافة %lld تذكيرات موزعة على الأيام القادمة، لتصلك واحدًا تلو الآخر، لا دفعة واحدة. يمكنك تخصيص أي منها متى شئت."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "تمت إضافة %lld تذكيرًا موزعًا على الأيام القادمة، لتصلك واحدًا تلو الآخر، لا دفعة واحدة. يمكنك تخصيص أي منها متى شئت."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "عدد التذكيرات المضافة: %lld. سيصلك التذكير في الأيام القادمة. يمكنك تخصيصه متى شئت."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "تمت إضافة %lld تذكير موزع على الأيام القادمة، لتصلك واحدًا تلو الآخر، لا دفعة واحدة. يمكنك تخصيص أي منها متى شئت."
                }
              },
              "two": {
                "stringUnit": {
                  "state": "translated",
                  "value": "عدد التذكيرات المضافة: %lld. وُزّعا على الأيام القادمة ليصلا إليك واحدًا تلو الآخر، لا دفعة واحدة. يمكنك تخصيص أي منهما متى شئت."
                }
              },
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "عدد التذكيرات المضافة: %lld. تُوزّع التذكيرات على الأيام القادمة لتصلك واحدًا تلو الآخر، لا دفعة واحدة. يمكنك تخصيص أي منها متى شئت."
                }
              }
            }
          }
        },
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Erinnerung hinzugefügt. Du kannst sie jederzeit anpassen."
