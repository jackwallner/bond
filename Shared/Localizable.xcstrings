    "Little Gestures is a small app for the two of you, little reminders, shared milestones, and a daily check-in.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Little Gestures تطبيق صغير لكما أنتما الاثنين: تذكيرات صغيرة، ومناسبات مشتركة، واطمئنان يومي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Little Gestures ist eine kleine App für euch zwei: kleine Erinnerungen, gemeinsame Meilensteine und ein täglicher Check-in."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Little Gestures is a small app for the two of you, little reminders, shared milestones, and a daily check-in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Little Gestures es una app pequeña para los dos: recordatorios, fechas especiales compartidas y un check-in diario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Little Gestures est une petite app pour vous deux : de petits rappels, des dates partagées et un check-in du jour."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Little Gestures é um app pequeno para vocês dois: lembretes, datas especiais compartilhadas e um check-in diário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Little Gestures, небольшое приложение для вас двоих: напоминания, общие важные даты и вопрос дня."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Little Gestures là ứng dụng nhỏ dành cho hai bạn: những lời nhắc nhỏ, cột mốc chung và hỏi thăm hằng ngày."
          }
        }
      }
    },
    "Little Gestures is just for you right now. Pair to share reminders. You keep everything you've already added.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Little Gestures لك وحدك الآن. اربط حسابك بشريكك لمشاركة التذكيرات. وكل ما أضفته يبقى كما هو."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Little Gestures gehört im Moment nur dir. Verbinde dich, um Erinnerungen zu teilen. Alles, was du schon hinzugefügt hast, bleibt erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Little Gestures is just for you right now. Pair to share reminders. You keep everything you've already added."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora mismo Little Gestures es solo para ti. Vincúlate para compartir recordatorios. Conservas todo lo que ya has añadido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour l'instant, Little Gestures est rien que pour toi. Associe-toi à ton ou ta partenaire pour partager des rappels. Tu gardes tout ce que tu as déjà ajouté."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No momento, o Little Gestures é só seu. Conecte-se para compartilhar lembretes. Tudo o que você já adicionou continua aí."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас Little Gestures только для тебя. Свяжись с партнёром, чтобы делиться напоминаниями. Всё уже добавленное останется на месте."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện Little Gestures chỉ dành cho riêng bạn. Hãy ghép đôi để chia sẻ lời nhắc. Mọi thứ bạn đã thêm vẫn được giữ nguyên."
          }
        }
      }
    },
    "Little Gestures is silent without your permission.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Little Gestures يبقى صامتًا دون إذنك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne deine Erlaubnis bleibt Little Gestures stumm."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Little Gestures is silent without your permission."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin tu permiso, Little Gestures no puede avisarte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Little Gestures reste muet sans ton autorisation."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Little Gestures fica em silêncio sem a sua permissão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без твоего разрешения Little Gestures молчит."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Little Gestures sẽ không gửi thông báo nếu bạn chưa cho phép."
          }
        }
      }
    },
    "Little Gestures needs a connection the first time you open it. Check your network and try again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج Little Gestures إلى اتصال بالإنترنت عند فتحه أول مرة. تحقّق من الشبكة وحاول مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Little Gestures braucht beim ersten Öffnen eine Verbindung. Prüfe dein Netzwerk und versuch es noch mal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Little Gestures needs a connection the first time you open it. Check your network and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Little Gestures necesita conexión la primera vez que la abres. Revisa tu red e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Little Gestures a besoin d'une connexion à la première ouverture. Vérifie ton réseau et réessaie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Little Gestures precisa de conexão na primeira vez que você o abre. Verifique sua rede e tente de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При первом запуске Little Gestures нужен интернет. Проверь подключение и попробуй снова."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lần đầu mở, Little Gestures cần có kết nối mạng. Hãy kiểm tra mạng rồi thử lại."
          }
        }
      }
    },
