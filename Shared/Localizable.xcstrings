    "Pairing connects your reminders with your partner's. Apple Sign-In keeps that link recoverable across devices.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الربط يصل تذكيراتك بتذكيرات شريكك. ويُبقي Sign in with Apple هذا الربط قابلًا للاستعادة عبر أجهزتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Verbinden werden deine Erinnerungen mit denen deines Partners verknüpft. Mit Sign in with Apple lässt sich diese Verbindung geräteübergreifend wiederherstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing connects your reminders with your partner's. Apple Sign-In keeps that link recoverable across devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al vincularse, tus recordatorios se conectan con los de tu pareja. Con Sign in with Apple puedes recuperar ese vínculo en cualquier dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'association relie tes rappels à ceux de ton ou ta partenaire. Sign in with Apple te permet de retrouver ce lien sur tes appareils."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão liga seus lembretes aos do seu amor. O Sign in with Apple mantém esse vínculo recuperável entre dispositivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда вы создадите пару, ваши напоминания будут связаны. Sign in with Apple поможет восстановить связь на других устройствах."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghép đôi giúp kết nối lời nhắc của bạn với lời nhắc của nửa kia. Sign in with Apple giúp bạn khôi phục liên kết này trên mọi thiết bị."
          }
        }
      }
    },
    "Pairing didn't work. Check the code and try again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم ينجح الربط. تحقّق من الرمز وحاول مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
