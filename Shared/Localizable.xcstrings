    "Payment charged to your Apple ID. Renews unless cancelled at least 24 hours before period end.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُخصم المبلغ من حساب Apple ID الخاص بك. يتجدد الاشتراك ما لم يُلغَ قبل نهاية الفترة بـ 24 ساعة على الأقل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zahlung wird deiner Apple-ID belastet. Das Abo verlängert sich, wenn du nicht mindestens 24 Stunden vor Ablauf des Zeitraums kündigst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Payment charged to your Apple ID. Renews unless cancelled at least 24 hours before period end."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pago se cargará a tu Apple ID. Se renueva automáticamente salvo que lo canceles al menos 24 horas antes de que termine el periodo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le paiement est débité de ton compte Apple. Renouvellement automatique sauf annulation au moins 24 heures avant la fin de la période."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagamento cobrado no seu ID Apple. Renova, a menos que seja cancelado pelo menos 24 horas antes do fim do período."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оплата списывается с твоего Apple ID. Подписка продлевается, если не отменить её минимум за 24 часа до конца периода."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khoản thanh toán sẽ được tính vào Apple ID của bạn. Gói tự động gia hạn trừ khi bạn hủy ít nhất 24 giờ trước khi kết thúc kỳ hiện tại."
          }
        }
      }
    },
    "Payment went through but we're still syncing. Tap Restore on the next screen.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت عملية الدفع لكننا ما زلنا نزامن. اضغط على استعادة في الشاشة التالية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zahlung ist durch, aber wir synchronisieren noch. Tippe auf dem nächsten Bildschirm auf „Wiederherstellen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Payment went through but we're still syncing. Tap Restore on the next screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pago se ha realizado, pero seguimos sincronizando. Toca Restaurar en la siguiente pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
