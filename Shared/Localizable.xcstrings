    "Showing up for %@ isn't a feature, it's a choice. Make it now, and Little Gestures will help you keep it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحضور من أجل %@ ليس ميزة، بل اختيار. اتخذه الآن، وسيساعدك Little Gestures على الالتزام به."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für %@ da zu sein ist kein Feature, sondern eine Entscheidung. Triff sie jetzt, und Little Gestures hilft dir, dabei zu bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Showing up for %@ isn't a feature, it's a choice. Make it now, and Little Gestures will help you keep it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estar ahí para %@ no es una función, es una decisión. Tómala ahora y Little Gestures te ayudará a cumplirla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Être là pour %@, ce n'est pas une fonctionnalité, c'est un choix. Fais-le maintenant, et Little Gestures t'aidera à le tenir."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
