    "Pick any that fit. Your first choice is their primary, we'll lean toward it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر ما يناسب. أول اختيار هو الأساسي، وسنعطيه الأولوية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähl alles aus, was passt. Deine erste Wahl gilt als Hauptsprache, darauf richten wir uns stärker aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick any that fit. Your first choice is their primary, we'll lean toward it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige las que encajen. Tu primera opción será la principal y nos guiaremos por ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis tout ce qui lui correspond. Ton premier choix sera son langage principal, on le privilégiera."
