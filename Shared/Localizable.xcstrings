    "Both of you answer the same prompt. You see each other's once you've both replied.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجيب كلاكما عن السؤال نفسه. ويظهر ردّ كل منكما للآخر بعد أن تجيبا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr beantwortet beide dieselbe Frage. Die Antworten seht ihr erst, wenn ihr beide geantwortet habt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both of you answer the same prompt. You see each other's once you've both replied."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada uno responde a la misma pregunta. Podrás ver las respuestas cuando ambos hayan contestado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous répondez tous les deux à la même question. Vous voyez la réponse de l’autre dès que vous avez tous les deux répondu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocês dois respondem à mesma pergunta. Cada um vê a resposta do outro quando os dois tiverem respondido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы оба отвечаете на один и тот же вопрос. Ответы друг друга откроются, когда ответите оба."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cả hai cùng trả lời một câu hỏi. Khi cả hai đã trả lời, bạn sẽ thấy câu trả lời của nhau."
          }
        }
      }
    },
