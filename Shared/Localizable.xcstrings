    "Your partner's invite is ready. Sign in with Apple so they stay paired with you across devices.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دعوة شريكك جاهزة. استخدم Sign in with Apple ليبقى مرتبطًا بك عبر الأجهزة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einladung deines Partners ist bereit. Melde dich mit Sign in with Apple an, damit ihr auf allen Geräten verbunden bleibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your partner's invite is ready. Sign in with Apple so they stay paired with you across devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La invitación de tu pareja está lista. Usa Sign in with Apple para mantener la vinculación en todos tus dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'invitation de ton ou ta partenaire est prête. Utilise Sign in with Apple pour que vos comptes restent associés sur tous tes appareils."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O convite do seu amor está pronto. Use Sign in with Apple para manter o vínculo entre vocês em todos os dispositivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приглашение от партнёра готово. Войди через Sign in with Apple, чтобы ваша пара сохранялась на всех устройствах."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lời mời của nửa kia đã sẵn sàng. Hãy dùng Sign in with Apple để giữ kết nối với người ấy trên các thiết bị."
          }
        }
      }
    },
    "Your partner. Little Gestures is built to help you keep showing up for them.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شريكك. صُمم Little Gestures ليساعدك على أن تبقى حاضرًا من أجله دائمًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Partner. Little Gestures hilft dir, immer wieder für ihn da zu sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your partner. Little Gestures is built to help you keep showing up for them."
          }
        },
        "es": {
