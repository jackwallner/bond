        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu amor. O Little Gestures foi feito para ajudar você a continuar presente para essa pessoa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твой партнёр. Little Gestures помогает не забывать о знаках внимания каждый день."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nửa kia của bạn. Little Gestures giúp bạn luôn quan tâm đến người ấy."
          }
        }
      }
    },
    "Your payment is pending approval. We'll unlock Little Gestures+ as soon as it clears.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دفعتك بانتظار الموافقة. سنفعّل Little Gestures+ فور الموافقة عليها."
          }
        },
        "de": {
          "stringUnit": {
