    "Unpairing stops your partner from sending you anything. Reporting lets us know about abusive content.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلغاء الربط يمنع شريكك من إرسال أي شيء إليك. الإبلاغ يتيح لنا معرفة المحتوى المسيء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du die Verbindung trennst, kann dein Partner dir nichts mehr schicken. Mit einer Meldung informierst du uns über missbräuchliche Inhalte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unpairing stops your partner from sending you anything. Reporting lets us know about abusive content."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al desvincular, tu pareja deja de poder enviarte cosas. Al informar de un problema, nos avisas de contenido abusivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dissocier arrête tout envoi de ton ou ta partenaire. Un signalement nous informe des contenus abusifs."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao desconectar, seu amor não poderá mais enviar nada para você. Ao denunciar, você nos avisa sobre conteúdo abusivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если отвязать партнёра, он перестанет что-либо тебе отправлять. Жалоба сообщит нам о недопустимом контенте."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hủy ghép đôi sẽ ngăn nửa kia gửi bất cứ thứ gì cho bạn. Báo cáo giúp chúng tôi biết về nội dung mang tính lạm dụng."
          }
        }
      }
    },
