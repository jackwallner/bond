    "That code didn't work. It may have expired. Ask your partner for a fresh one.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الرمز لم يعمل. ربما انتهت صلاحيته. اطلب من شريكك رمزاً جديداً."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Code hat nicht funktioniert. Vielleicht ist er abgelaufen. Bitte deinen Partner um einen neuen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That code didn't work. It may have expired. Ask your partner for a fresh one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese código no funciona. Puede que haya caducado. Pídele uno nuevo a tu pareja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce code n'a pas marché. Il a peut-être expiré. Demande-en un nouveau à ton ou ta partenaire."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse código não funcionou. Ele pode ter expirado. Peça um novo ao seu amor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот код не подошёл. Возможно, срок его действия истёк. Попроси у партнёра новый."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mã này không dùng được. Có thể mã đã hết hạn. Hãy xin nửa kia một mã mới."
          }
        }
      }
    },
    "That's your own code. Share it with your partner and enter theirs here.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا رمزك أنت. شاركه مع شريكك وأدخل رمزه هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist dein eigener Code. Teile ihn mit deinem Partner und gib hier den Code deines Partners ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That's your own code. Share it with your partner and enter theirs here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese es tu propio código. Compártelo con tu pareja e introduce aquí el suyo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est ton propre code. Partage-le avec ton ou ta partenaire et saisis le sien ici."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse é o seu próprio código. Compartilhe com seu amor e digite aqui o código que receber."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это твой код. Отправь его партнёру, а здесь введи код партнёра."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là mã của chính bạn. Hãy gửi cho nửa kia và nhập mã của người ấy vào đây."
          }
        }
      }
    },
    "The App Store had a problem. Wait a moment and try again, or tap Restore.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدثت مشكلة في App Store. انتظر قليلاً وحاول مجدداً، أو اضغط على استعادة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim App Store ist ein Problem aufgetreten. Warte einen Moment und versuche es erneut oder tippe auf „Wiederherstellen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The App Store had a problem. Wait a moment and try again, or tap Restore."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La App Store ha tenido un problema. Espera un momento e inténtalo de nuevo, o toca Restaurar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'App Store a rencontré un problème. Patiente un instant et réessaie, ou touche Restaurer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A App Store teve um problema. Aguarde um instante e tente de novo, ou toque em Restaurar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проблема с App Store. Подожди немного и повтори попытку или нажми «Восстановить»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store gặp sự cố. Đợi một lát rồi thử lại, hoặc chạm Khôi phục."
          }
        }
      }
    },
